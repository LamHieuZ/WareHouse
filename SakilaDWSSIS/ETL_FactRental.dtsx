                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.payment.customer_id, dbo.payment.staff_id, dbo.rental.return_date, dbo.payment.amount, dbo.rental.rental_date, dbo.inventory.film_id, dbo.film.rental_rate, dbo.film.rental_duration, dbo.inventory.store_id
FROM   dbo.payment, dbo.rental, dbo.inventory, dbo.film
WHERE dbo.payment.rental_id = dbo.rental.rental_id AND dbo.rental.inventory_id = dbo.inventory.inventory_id AND dbo.inventory.film_id = dbo.film.film_id</property>
