                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.staff.first_name, dbo.staff.last_name, dbo.store.store_id, dbo.address.address, dbo.country.country, dbo.city.city
FROM   dbo.store, dbo.staff, dbo.address, dbo.city, dbo.country
WHERE dbo.store.manager_staff_id = dbo.staff.staff_id AND dbo.store.store_id = dbo.staff.store_id AND dbo.store.address_id = dbo.address.address_id AND dbo.address.city_id = dbo.city.city_id AND dbo.city.country_id = dbo.country.country_id</property>
