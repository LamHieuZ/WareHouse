                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.film.film_id, dbo.film.title, dbo.film.release_year, dbo."language".name, dbo.category.name AS Expr1, dbo.film.replacement_cost, dbo.film.rating, dbo.film.rental_rate, dbo.film.rental_duration
FROM   dbo."language", dbo.film, dbo.film_category, dbo.category
