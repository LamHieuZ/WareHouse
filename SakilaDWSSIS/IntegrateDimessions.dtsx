                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.customer.first_name, dbo.customer.last_name, dbo.customer.customer_id, dbo.customer.email, dbo.address.address, dbo.city.city, dbo.country.country, dbo.address.postal_code, dbo.address.phone, dbo.customer.active
FROM   dbo.address, dbo.city, dbo.country, dbo.customer
WHERE dbo.address.city_id = dbo.city.city_id AND dbo.city.country_id = dbo.country.country_id AND dbo.address.address_id = dbo.customer.address_id</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
