                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.staff.staff_id, dbo.staff.first_name, dbo.staff.last_name, dbo.staff.email, dbo.staff.active, dbo.staff.username, dbo.staff.password, dbo.address.address, dbo.address.postal_code, dbo.address.phone, dbo.city.city, dbo.country.country
FROM   dbo.staff, dbo.address, dbo.city, dbo.country
WHERE dbo.staff.address_id = dbo.address.address_id AND dbo.address.city_id = dbo.city.city_id AND dbo.city.country_id = dbo.country.country_id</property>
